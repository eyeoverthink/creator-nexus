{
  "name": "FraymusVocalAnalysis",
  "type": "object",
  "description": "Owner-scoped, explicitly imported local-PC vocal emotion estimates. Audio never enters this entity. Reports are user-supplied, not hardware-attested or human emotion ground truth.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "audio_sha256": {
      "type": "string"
    },
    "report_sha256": {
      "type": "string"
    },
    "report": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "title",
    "audio_sha256",
    "report_sha256",
    "report",
    "enabled"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
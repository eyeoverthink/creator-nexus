{
  "name": "TimeAuditEntry",
  "type": "object",
  "description": "One logged half hour of the time audit: what was done, energy 1-10 and the dollar value of that half hour.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "slot_date": {
      "type": "string",
      "format": "date"
    },
    "slot_time": {
      "type": "string",
      "maxLength": 5
    },
    "activity": {
      "type": "string",
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "inbox",
        "calendar",
        "meetings",
        "family",
        "health",
        "shopping",
        "chores",
        "admin",
        "content",
        "sales",
        "money",
        "client_work",
        "deep_work",
        "learning",
        "rest",
        "other"
      ]
    },
    "energy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "dollar_value": {
      "type": "number",
      "minimum": 0
    },
    "complaint": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "owner_id",
    "slot_date",
    "slot_time",
    "activity",
    "category",
    "energy",
    "dollar_value"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
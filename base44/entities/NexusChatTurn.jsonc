{
  "name": "NexusChatTurn",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "researcher",
        "writer",
        "strategist"
      ]
    },
    "question": {
      "type": "string",
      "maxLength": 2000
    },
    "answer": {
      "type": "string",
      "maxLength": 12000
    },
    "sources": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "excerpt": {
            "type": "string",
            "maxLength": 2400
          }
        },
        "required": [
          "id",
          "title",
          "excerpt"
        ]
      }
    },
    "provider": {
      "type": "string",
      "enum": [
        "hosted",
        "ollama"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 160
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "agent",
    "question",
    "answer",
    "provider"
  ]
}
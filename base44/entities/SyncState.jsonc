{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "sync_token": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string"
    },
    "synced_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "NexusRemoteKey",
  "type": "object",
  "description": "Server-managed personal keys for the remote API. Only a SHA-256 fingerprint of each key is stored; the key itself is shown once when created.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "key_hash": {
      "type": "string"
    },
    "key_hint": {
      "type": "string",
      "maxLength": 8
    },
    "last_used_at": {
      "type": "string"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "owner_id",
    "label",
    "key_hash",
    "key_hint",
    "revoked"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
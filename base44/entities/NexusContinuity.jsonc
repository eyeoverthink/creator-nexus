{
  "name": "NexusContinuity",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "profile",
        "models",
        "researcher",
        "writer",
        "strategist",
        "director",
        "witness"
      ]
    },
    "display_name": {
      "type": "string",
      "maxLength": 100
    },
    "context": {
      "type": "string",
      "maxLength": 6000
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "scope"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
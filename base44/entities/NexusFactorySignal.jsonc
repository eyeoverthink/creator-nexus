{
  "name": "NexusFactorySignal",
  "type": "object",
  "description": "Sourced observation from user mood/energy input, project activity, musical tonality, or public trend/news feeds that informs creative production direction. Inspectable, editable, and toggleable by the user.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "signal_kind": {
      "type": "string",
      "enum": [
        "user_mood",
        "project_activity",
        "music_tonality",
        "world_trend",
        "source_verification"
      ],
      "default": "user_mood"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "mood_energy": {
      "type": "string",
      "maxLength": 120
    },
    "agent_observer": {
      "type": "string",
      "maxLength": 80
    },
    "provenance": {
      "type": "string",
      "maxLength": 300
    },
    "source_url": {
      "type": "string",
      "maxLength": 1000
    },
    "included": {
      "type": "boolean",
      "default": true
    },
    "observed_at": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "signal_kind",
    "title",
    "summary",
    "provenance"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
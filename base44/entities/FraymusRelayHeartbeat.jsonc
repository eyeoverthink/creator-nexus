{
  "name": "FraymusRelayHeartbeat",
  "type": "object",
  "description": "Persistent scheduled relay checkpoint. A recorded tick is not an AI reasoning turn or proof of 24/7 uptime.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "last_started_at": {
      "type": "string"
    },
    "last_completed_at": {
      "type": "string"
    },
    "running_until": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "tick_count": {
      "type": "integer",
      "default": 0
    },
    "last_result": {
      "type": "object"
    },
    "last_error": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "running_until"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "NexusAssetRevision",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "note": {
      "type": "string",
      "maxLength": 300
    },
    "snapshot": {
      "type": "object"
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "asset_id",
    "version",
    "snapshot"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
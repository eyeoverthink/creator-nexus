{
  "name": "NexusLearningRun",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "researcher",
        "writer",
        "strategist"
      ]
    },
    "engine": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "rounds": {
      "type": "integer"
    },
    "metrics": {
      "type": "object"
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "agent",
    "engine",
    "seed",
    "rounds",
    "metrics"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
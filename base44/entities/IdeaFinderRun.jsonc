{
  "name": "IdeaFinderRun",
  "type": "object",
  "description": "One Million Dollar Idea Finder run: inputs, time-audit snapshot, ranked complaints and 3 ideas. Revenue figures are goals, not guarantees.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "niche": {
      "type": "string",
      "maxLength": 200
    },
    "complaints": {
      "type": "string",
      "maxLength": 4000
    },
    "price_usd": {
      "type": "number"
    },
    "buyers": {
      "type": "integer"
    },
    "hourly_value": {
      "type": "number"
    },
    "provider": {
      "type": "string",
      "enum": [
        "hosted",
        "ollama"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 160
    },
    "web_research": {
      "type": "boolean",
      "default": false
    },
    "audit_snapshot": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ]
    },
    "my_complaints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "niche_complaints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": "string",
      "maxLength": 1000
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "niche",
    "provider",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
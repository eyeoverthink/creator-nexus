{
  "name": "MotivationTarget",
  "type": "object",
  "description": "An ambitious money goal used as a motivation metric only. Not a guarantee and never triggers any action.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "maxLength": 160
    },
    "amount_usd": {
      "type": "number",
      "minimum": 0
    },
    "by_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "owner_id",
    "label",
    "amount_usd"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "FraymusContinuityEntry",
  "type": "object",
  "description": "Durable creator directive/archive and bounded peer outbox. Peer responded does not prove independent storage or authenticated duplex. No automatic model runs or code changes.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "builder_snapshot",
        "creator_directive",
        "capability_update",
        "app_chat",
        "app_event"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "text": {
      "type": "string",
      "maxLength": 16000
    },
    "source_ref": {
      "type": "string",
      "maxLength": 240
    },
    "content_sha256": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "waiting",
        "peer_responded"
      ]
    },
    "attempts": {
      "type": "integer",
      "default": 0
    },
    "next_attempt_at": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "lease_until": {
      "type": "string"
    },
    "last_attempt_at": {
      "type": "string"
    },
    "peer_receipt": {
      "type": "object"
    },
    "last_error": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "kind",
    "title",
    "text",
    "source_ref",
    "content_sha256",
    "status",
    "next_attempt_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
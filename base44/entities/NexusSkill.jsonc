{
  "name": "NexusSkill",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "researcher",
        "writer",
        "strategist",
        "director",
        "witness"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "instructions": {
      "type": "string",
      "maxLength": 4000
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "agent",
    "name",
    "instructions"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
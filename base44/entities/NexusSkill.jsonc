{
  "name": "NexusSkill",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "researcher",
        "writer",
        "strategist"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "instructions": {
      "type": "string",
      "maxLength": 4000
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "agent",
    "name",
    "instructions"
  ]
}
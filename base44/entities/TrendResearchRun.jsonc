{
  "name": "TrendResearchRun",
  "type": "object",
  "description": "A search-first research run: supplied sources with per-source retrieval status, real YouTube results, and AI findings labeled retrieved vs synthesis. Never triggers external actions.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "maxLength": 1000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "has_image": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ]
    },
    "youtube": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_id",
    "query",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
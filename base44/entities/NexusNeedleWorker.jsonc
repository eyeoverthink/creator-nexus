{
  "name": "NexusNeedleWorker",
  "type": "object",
  "description": "Server-managed, owner-scoped Needle worker pairing and worker-reported runtime checks. Not hardware attestation.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "paired",
        "ready",
        "revoked"
      ]
    },
    "last_seen": {
      "type": "string"
    },
    "attestation_json": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": [
    "owner_id",
    "workspace_id",
    "token_hash",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
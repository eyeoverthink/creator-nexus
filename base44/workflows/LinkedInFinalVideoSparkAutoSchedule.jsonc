{
  "name": "LinkedIn Final Video Spark Auto-Schedule",
  "description": "Automatically schedules final Video Sparks for LinkedIn feed distribution as soon as their script is reviewed and queued.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "SparkCard",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"queued\" and (.trigger.old_data.status // \"\") != \"queued\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "linkedin_final_video_spark_auto_schedule",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "schedule_video_spark": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "linkedinSparkPublisher",
            "args": {
              "action": "auto_enqueue_spark",
              "workspace_id": "${ .trigger.data.workspace_id }",
              "event_id": "${ .trigger.data.job_event_id }"
            }
          },
          "then": "check_immediate_slot",
          "x-base44": {
            "title": "Queue final Video Spark for LinkedIn",
            "description": "Computes next peak LinkedIn slot"
          }
        }
      },
      {
        "check_immediate_slot": {
          "switch": [
            {
              "when": "${ .schedule_video_spark.publish_now == true }",
              "then": "publish_video_spark_now"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "In peak LinkedIn window now?",
            "description": "Publish immediately or wait for scheduled dispatcher"
          }
        }
      },
      {
        "publish_video_spark_now": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "linkedinSparkPublisher",
            "args": {
              "action": "publish_spark",
              "item_type": "spark_card",
              "item_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Publish Video Spark to LinkedIn",
            "description": "Pushes Video Spark to LinkedIn feed"
          }
        }
      }
    ]
  }
}